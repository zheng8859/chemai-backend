# ChemAI 环境变量模板 — 复制为 .env 后填入实际值
# 详见 38-技术选型与工具链.md 和 app/config.py

# ── 数据库 ──
DATABASE_URL=sqlite+aiosqlite:///data/chemai.db
CHECKPOINT_DB_URL=sqlite+aiosqlite:///data/checkpoint.db
MEMORY_DB_URL=sqlite+aiosqlite:///data/memory.db

# ── LLM Provider ──
MIMO_API_KEY=
MIMO_BASE_URL=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
ZHIPU_API_KEY=

# ── OCR 管道 ──
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ── 安全 ──
JWT_SECRET=change-me-in-production
